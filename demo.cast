[32.292837, "o", "\u001b[0;37m     filter: candidate_set='river-and-landscape-2026', eligible=true\u001b[0m\r\n"]
[32.951065, "o", "\u001b[1;34m  -> visual decision: needed=True\u001b[0m\r\n"]
